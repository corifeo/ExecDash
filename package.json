{
  "name": "execdash",
  "version": "0.2.0",
  "description": "ExecDash: an executive cyber security dashboard with a built-in configuration screen, in a single HTML file.",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/release-notes.mjs --check",
    "release-notes": "node scripts/release-notes.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "python3 tests/smoke_test.py",
    "screenshots": "python3 scripts/screenshots.py",
    "format": "npx prettier@3 --write \"src/**/*.{js,css}\" scripts/build.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
